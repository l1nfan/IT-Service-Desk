<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itsm.ticket.mapper.workflow.WfTaskMapper">

    <resultMap type="WfTask" id="WfTaskResult">
        <id     property="taskId"         column="task_id"         />
        <result property="instanceId"     column="instance_id"     />
        <result property="workflowId"     column="workflow_id"     />
        <result property="businessId"     column="business_id"     />
        <result property="nodeKey"        column="node_key"        />
        <result property="nodeName"       column="node_name"       />
        <result property="assigneeId"     column="assignee_id"     />
        <result property="assigneeName"   column="assignee_name"   />
        <result property="status"         column="status"          />
        <result property="action"         column="action"          />
        <result property="comment"        column="comment"         />
        <result property="claimTime"      column="claim_time"      />
        <result property="completeTime"   column="complete_time"   />
        <result property="createTime"     column="create_time"     />
    </resultMap>

    <sql id="selectWfTaskVo">
        select task_id, instance_id, workflow_id, business_id, node_key, node_name,
               assignee_id, assignee_name, status, action, comment,
               claim_time, complete_time, create_time
        from wf_task
    </sql>

    <select id="selectTaskById" parameterType="Long" resultMap="WfTaskResult">
        <include refid="selectWfTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectTasksByInstanceId" parameterType="Long" resultMap="WfTaskResult">
        <include refid="selectWfTaskVo"/>
        where instance_id = #{instanceId}
        order by create_time desc
    </select>

    <select id="selectPendingTasksByAssignee" parameterType="Long" resultMap="WfTaskResult">
        <include refid="selectWfTaskVo"/>
        where assignee_id = #{assigneeId} and status = 'PENDING'
        order by create_time desc
    </select>

    <select id="selectCompletedTasksByAssignee" parameterType="Long" resultMap="WfTaskResult">
        <include refid="selectWfTaskVo"/>
        where assignee_id = #{assigneeId} and status = 'COMPLETED'
        order by create_time desc
    </select>

    <select id="selectTasksByBusinessId" resultMap="WfTaskResult">
        <include refid="selectWfTaskVo"/>
        where instance_id in (select instance_id from wf_instance where business_id = #{businessId} and business_type = #{businessType})
        order by create_time desc
    </select>

    <insert id="insertTask" parameterType="WfTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into wf_task (
            <if test="instanceId != null">instance_id,</if>
            <if test="workflowId != null">workflow_id,</if>
            <if test="businessId != null">business_id,</if>
            <if test="nodeKey != null and nodeKey != ''">node_key,</if>
            <if test="nodeName != null and nodeName != ''">node_name,</if>
            <if test="assigneeId != null">assignee_id,</if>
            <if test="assigneeName != null and assigneeName != ''">assignee_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="action != null and action != ''">action,</if>
            <if test="comment != null and comment != ''">comment,</if>
            <if test="claimTime != null">claim_time,</if>
            <if test="completeTime != null">complete_time,</if>
            create_time
        )values(
            <if test="instanceId != null">#{instanceId},</if>
            <if test="workflowId != null">#{workflowId},</if>
            <if test="businessId != null">#{businessId},</if>
            <if test="nodeKey != null and nodeKey != ''">#{nodeKey},</if>
            <if test="nodeName != null and nodeName != ''">#{nodeName},</if>
            <if test="assigneeId != null">#{assigneeId},</if>
            <if test="assigneeName != null and assigneeName != ''">#{assigneeName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="action != null and action != ''">#{action},</if>
            <if test="comment != null and comment != ''">#{comment},</if>
            <if test="claimTime != null">#{claimTime},</if>
            <if test="completeTime != null">#{completeTime},</if>
            sysdate()
        )
    </insert>

    <update id="updateTask" parameterType="WfTask">
        update wf_task
        <set>
            <if test="instanceId != null">instance_id = #{instanceId},</if>
            <if test="workflowId != null">workflow_id = #{workflowId},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
            <if test="nodeKey != null and nodeKey != ''">node_key = #{nodeKey},</if>
            <if test="nodeName != null and nodeName != ''">node_name = #{nodeName},</if>
            <if test="assigneeId != null">assignee_id = #{assigneeId},</if>
            <if test="assigneeName != null and assigneeName != ''">assignee_name = #{assigneeName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="action != null and action != ''">action = #{action},</if>
            <if test="comment != null">comment = #{comment},</if>
            <if test="claimTime != null">claim_time = #{claimTime},</if>
            <if test="completeTime != null">complete_time = #{completeTime},</if>
        </set>
        where task_id = #{taskId}
    </update>

</mapper>
