<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itsm.ticket.mapper.workflow.WfInstanceMapper">

    <resultMap type="WfInstance" id="WfInstanceResult">
        <id     property="instanceId"       column="instance_id"       />
        <result property="workflowId"       column="workflow_id"       />
        <result property="businessId"       column="business_id"       />
        <result property="businessType"     column="business_type"     />
        <result property="currentNodeKey"   column="current_node_key"  />
        <result property="status"           column="status"            />
        <result property="startTime"        column="start_time"        />
        <result property="endTime"          column="end_time"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
    </resultMap>

    <sql id="selectWfInstanceVo">
        select instance_id, workflow_id, business_id, business_type, current_node_key, status,
               start_time, end_time, create_by, create_time
        from wf_instance
    </sql>

    <select id="selectInstanceById" parameterType="Long" resultMap="WfInstanceResult">
        <include refid="selectWfInstanceVo"/>
        where instance_id = #{instanceId}
    </select>

    <select id="selectInstanceByBusinessId" resultMap="WfInstanceResult">
        <include refid="selectWfInstanceVo"/>
        where business_id = #{businessId} and business_type = #{businessType}
    </select>

    <insert id="insertInstance" parameterType="WfInstance" useGeneratedKeys="true" keyProperty="instanceId">
        insert into wf_instance (
            <if test="workflowId != null">workflow_id,</if>
            <if test="businessId != null">business_id,</if>
            <if test="businessType != null and businessType != ''">business_type,</if>
            <if test="currentNodeKey != null and currentNodeKey != ''">current_node_key,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="workflowId != null">#{workflowId},</if>
            <if test="businessId != null">#{businessId},</if>
            <if test="businessType != null and businessType != ''">#{businessType},</if>
            <if test="currentNodeKey != null and currentNodeKey != ''">#{currentNodeKey},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateInstance" parameterType="WfInstance">
        update wf_instance
        <set>
            <if test="workflowId != null">workflow_id = #{workflowId},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
            <if test="businessType != null and businessType != ''">business_type = #{businessType},</if>
            <if test="currentNodeKey != null and currentNodeKey != ''">current_node_key = #{currentNodeKey},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
        </set>
        where instance_id = #{instanceId}
    </update>

</mapper>
